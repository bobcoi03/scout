SCOUT_DB_PATH=./data/scout.db

# Public snapshot used by the hosted read-only application.
SCOUT_DATA_URL=
BLOB_READ_WRITE_TOKEN=

# Read-only X discovery through a dedicated account session.
# Copy only each cookie's value from x.com DevTools. Never commit this file with values.
X_SCRAPING_ENABLED=false
X_AUTH_TOKEN=
X_CT0=
X_MAX_POSTS_PER_QUERY=30
SCOUT_X_DISCOVERY_LIMIT=600

# OpenAI-backed curation. Discovery can collect up to 600 deduplicated posts
# and the inexpensive Nano pass reviews the strongest 300.
OAI_API_KEY=
SCOUT_ANALYST_MODEL=gpt-5.4-nano
SCOUT_ANALYST_DAILY_LIMIT=300
SCOUT_ANALYST_BATCH_SIZE=10
SCOUT_ARTIFACT_URLS_PER_POST=3
SCOUT_LINK_ENRICHMENT_LIMIT=60
SCOUT_WEB_SEARCH_LIMIT=5
SCOUT_VISUAL_REVIEW_LIMIT=30
SCOUT_VISUAL_MODEL=gpt-5.4-mini
SCOUT_RERANK_MODEL=gpt-5.4

# Production evidence-based investor review. The deeper review is capped at 30
# candidates and the final editor publishes at most eight selections per day.
SCOUT_INVESTIGATOR_REVIEW_LIMIT=30
SCOUT_INVESTIGATOR_WEB_SEARCH_LIMIT=10
SCOUT_INVESTIGATOR_FINALIST_LIMIT=15
SCOUT_INVESTIGATOR_PUBLISH_LIMIT=8
SCOUT_INVESTIGATOR_MODEL=gpt-5.4-mini
SCOUT_INVESTIGATOR_JUDGE_MODEL=gpt-5.4

# Optional. Raises the GitHub API limit for repository tree/code inspection.
GITHUB_TOKEN=
